{
  "framework": null,
  "buildCommand": "npm --prefix atlas-demo run build",
  "outputDirectory": "atlas-demo/dist",
  "installCommand": "npm --prefix atlas-demo install --no-audit --no-fund",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/mapdata/:path*",
      "destination": "https://tiles.openfreemap.org/:path*"
    }
  ]
}